    .section-title {
        font-size: 30px;
    }

    .products {
        grid-template-columns: 1fr;
    }

    .categories {
        gap: 8px;
    }

    .category-btn {
        padding: 10px 15px;

        font-size: 14px;
    }

}

/* =========================
   HIDDEN
========================= */

.hidden {
    display: none !important;
}

</style>
