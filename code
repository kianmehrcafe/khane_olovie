<style>
@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap');

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Vazirmatn", sans-serif;
    background: #050505;
    color: white;
    overflow-x: hidden;
}

/* =========================
   BACKGROUND
========================= */

body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -2;

    background:
        repeating-linear-gradient(
            135deg,
            transparent 0px,
            transparent 85px,
            rgba(255, 193, 7, 0.055) 86px,
            transparent 88px
        ),
        repeating-linear-gradient(
            45deg,
            transparent 0px,
            transparent 120px,
            rgba(150, 150, 150, 0.055) 121px,
            transparent 123px
        );
}

body::after {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;

    background:
        radial-gradient(
            circle at 20% 20%,
            rgba(255, 193, 7, 0.08),
            transparent 30%
        ),
        radial-gradient(
            circle at 80% 70%,
            rgba(255, 193, 7, 0.05),
            transparent 30%
        );
}

/* =========================
   HEADER
========================= */

header {
    position: sticky;
    top: 0;
    z-index: 1000;

    padding: 18px 25px;

    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);

    border-bottom: 1px solid rgba(255, 193, 7, 0.2);

    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    color: #ffc107;
    font-size: 25px;
    font-weight: 800;
}

nav a {
    color: white;
    text-decoration: none;
    margin-right: 20px;
    transition: 0.3s;
}

nav a:hover {
    color: #ffc107;
}

/* =========================
   HERO
========================= */

.hero {
    min-height: 65vh;

    display: flex;
    justify-content: center;
    align-items: center;

    text-align: center;

    padding: 70px 20px;
}

.hero-content {
    max-width: 850px;

    animation: heroIn 1s ease;
}

.hero h1 {
    font-size: clamp(45px, 8vw, 90px);

    color: #ffc107;

    margin-bottom: 15px;

    text-shadow:
        0 0 20px rgba(255, 193, 7, 0.25);
}

.hero p {
    color: #d0d0d0;

    font-size: 19px;

    line-height: 2;
}

/* =========================
   SECTIONS
========================= */

section {
    padding: 70px 7%;
}

.section-title {
    text-align: center;

    font-size: 38px;

    margin-bottom: 40px;

    color: #ffc107;
}

/* =========================
   SEARCH
========================= */

.controls {
    max-width: 850px;

    margin: 0 auto 35px;
}

.search {
    width: 100%;

    padding: 17px 22px;

    border-radius: 18px;

    border: 1px solid #333;

    background: #111;

    color: white;

    outline: none;

    font-family: inherit;

    font-size: 16px;

    transition: 0.3s;
}

.search:focus {
    border-color: #ffc107;

    box-shadow:
        0 0 20px rgba(255, 193, 7, 0.12);
}

/* =========================
   FAVORITES
========================= */

.favorite-filter {
    display: block;

    margin: 15px auto 0;

    padding: 12px 20px;

    border-radius: 14px;

    border: 1px solid #ffc107;

    background: transparent;

    color: #ffc107;

    cursor: pointer;

    font-family: inherit;

    font-size: 15px;

    transition: 0.3s;
}

.favorite-filter:hover,
.favorite-filter.active {
    background: #ffc107;

    color: black;
}

/* =========================
   CATEGORIES
========================= */

.categories {
    display: flex;

    flex-wrap: wrap;

    justify-content: center;

    gap: 12px;

    margin-bottom: 45px;
}

.category-btn {
    padding: 12px 22px;

    border-radius: 15px;

    border: 1px solid #333;

    background: #111;

    color: #ddd;

    cursor: pointer;

    font-family: inherit;

    font-size: 15px;

    transition: 0.3s;
}

.category-btn:hover {
    border-color: #ffc107;

    color: #ffc107;

    transform: translateY(-2px);
}

.category-btn.active {
    background: #ffc107;

    color: #050505;

    border-color: #ffc107;

    font-weight: 700;
}

/* =========================
   PRODUCTS GRID
========================= */

.products {
    display: grid;

    grid-template-columns:
        repeat(auto-fit, minmax(280px, 1fr));

    gap: 25px;
}

/* =========================
   CARD
========================= */

.card {
    position: relative;

    background: rgba(15, 15, 15, 0.94);

    border: 1px solid #292929;

    border-radius: 24px;

    padding: 25px;

    min-height: 210px;

    cursor: pointer;

    opacity: 0;

    transform: translateX(80px);

    transition:
        opacity 0.7s ease,
        transform 0.7s ease,
        border-color 0.3s,
        box-shadow 0.3s;
}

.card.right {
    transform: translateX(-80px);
}

.card.show {
    opacity: 1;

    transform: translateX(0);
}

.card:hover {
    border-color: rgba(255, 193, 7, 0.7);

    box-shadow:
        0 15px 50px rgba(0, 0, 0, 0.5),
        0 0 30px rgba(255, 193, 7, 0.08);

    transform: translateY(-7px);
}

.card h3 {
    font-size: 22px;

    color: #ffc107;

    margin-bottom: 12px;

    padding-left: 45px;
}

.card p {
    color: #aaa;

    line-height: 1.9;

    font-size: 14px;

    margin-bottom: 18px;
}

/* =========================
   PRICE
========================= */

.price {
    font-size: 20px;

    color: #fff;

    font-weight: 700;
}

.price span {
    color: #ffc107;

    font-size: 15px;

    margin-right: 4px;
}

/* =========================
   FAVORITE BUTTON
========================= */

.favorite {
    position: absolute;

    top: 20px;

    left: 20px;

    width: 42px;

    height: 42px;

    border-radius: 50%;

    border: 1px solid #444;

    background: rgba(0, 0, 0, 0.8);

    color: #aaa;

    cursor: pointer;

    font-size: 19px;

    transition: 0.3s;

    z-index: 5;
}

.favorite:hover {
    color: #ffc107;

    border-color: #ffc107;
}

.favorite.active {
    color: #ffc107;

    border-color: #ffc107;
}

/* =========================
   CONTACT
========================= */

.contact {
    text-align: center;

    background:
        linear-gradient(
            rgba(255, 193, 7, 0.035),
            rgba(255, 193, 7, 0.015)
        );

    border-top: 1px solid #222;

    border-bottom: 1px solid #222;
}

.contact p {
    margin: 15px 0;

    color: #ccc;

    line-height: 2;
}

.contact a {
    color: #ffc107;

    text-decoration: none;
}

/* =========================
   FOOTER
========================= */

footer {
    text-align: center;

    padding: 30px;

    color: #666;
}

/* =========================
   MODAL
========================= */

.modal {
    position: fixed;

    inset: 0;

    background: rgba(0, 0, 0, 0.82);

    backdrop-filter: blur(8px);

    display: none;

    align-items: center;

    justify-content: center;

    padding: 20px;

    z-index: 5000;
}

.modal.show {
    display: flex;
}

.modal-box {
    width: min(600px, 100%);

    background: #111;

    border: 1px solid #ffc107;

    border-radius: 25px;

    padding: 30px;

    position: relative;

    animation: modalIn 0.35s ease;
}

.close {
    position: absolute;

    top: 15px;

    left: 18px;

    border: none;

    background: none;

    color: #aaa;

    font-size: 28px;

    cursor: pointer;
}

.close:hover {
    color: #ffc107;
}

.modal h2 {
    color: #ffc107;

    margin-bottom: 15px;
}

.modal p {
    color: #ccc;

    line-height: 2;
}

.modal-rating {
    color: #ffc107;

    margin-top: 15px;

    font-size: 18px;
}

/* =========================
   ANIMATIONS
========================= */

@keyframes heroIn {

    from {
        opacity: 0;

        transform: translateY(35px);
    }

    to {
        opacity: 1;

        transform: translateY(0);
    }

}

@keyframes modalIn {

    from {
        opacity: 0;

        transform:
            scale(0.9)
            translateY(20px);
    }

    to {
        opacity: 1;

        transform:
            scale(1)
            translateY(0);
    }

}

/* =========================
   MOBILE
========================= */

@media (max-width: 700px) {

    header {
        padding: 15px;
    }

    .logo {
        font-size: 20px;
    }

    nav a {
        margin-right: 8px;

        font-size: 13px;
    }

    .hero {
